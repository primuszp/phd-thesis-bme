@incollection{rowe2009functional,
	title = {Functional {Forms} for {Master} {Curve} {Analysis} of {Bituminous} {Materials}},
	isbn = {978-0-415-55854-9},
	url = {http://www.crcnetbase.com/doi/abs/10.1201/9780203092989.ch9},
	abstract = {The modeling of asphalt materials to produce master curves is becoming more important in the development of pavement design methods. However, the current method being applied in the USA in the Mechanistic-Empirical Pavement Design Guide (MEPDG) uses a symmetrical sigmoidal model. This model can clearly be shown not to apply to many types of asphalt materials. This paper presents several additional approaches with different sigmoidal models which can be assessed within a mechanistic-empirical framework. This analysis is anticipated to be important as materials containing more modifiers are used and/or the greater use of materials not typical of those used to develop the original sigmoidal model adopted by many researchers. The generalized logistic sigmoid known as a Richards curve is a widely-used and flexible sigmoidal. Various forms of this generalized model are assessed and discussion is presented with relation to using this curve to describe the shape of a mastercurve of complex dynamic stiffness modulus of bituminous materials. The analysis shows that for the materials evaluated a generalized model format works very well. In addition, the data shows that the resulting master curves are non-symmetrical about a point of maximum gradient.},
	language = {en},
	urldate = {2022-10-18},
	booktitle = {Advanced {Testing} and {Characterization} of {Bituminous} {Materials}},
	publisher = {CRC Press},
	author = {Rowe, G and Baumgardner, G and Sharrock, M},
	editor = {Loizos, Andreas and Partl, Manfred and Scarpas, Tom and Al-Qadi, Imad},
	month = may,
	year = {2009},
	doi = {10.1201/9780203092989.ch9},
	file = {Functional Forms for Master Curve Analysis of Bituminous Materials (2009).pdf:D\:\\Personal\\OneDrive\\Dokumentumok\\Literature\\Pavement\\Functional Forms for Master Curve Analysis of Bituminous Materials (2009).pdf:application/pdf},
}

@inproceedings{pellinen2003asphalt,
	address = {Columbia University, New York, United States},
	title = {Asphalt {Mix} {Master} {Curve} {Construction} {Using} {Sigmoidal} {Fitting} {Function} with {Non}-{Linear} {Least} {Squares} {Optimization}},
	isbn = {978-0-7844-0709-7},
	url = {http://ascelibrary.org/doi/10.1061/40709%28257%296},
	doi = {10.1061/40709(257)6},
	abstract = {This paper presents a new simplified method of constructing a master curve of asphalt mix using test data covering a large range of temperatures from -18{\textasciitilde} to 55{\textasciitilde} It utilizes sigmoidal fitting function and compressive cyclic (complex) modulus test data obtained at matrix combination of different frequencies and test temperatures. In the master curve construction, the time temperature superposition was modeled two different ways. First, using known time-temperature superposition equations, and second, shifting test data experimentally, i.e., not assuming any functional form for the time-temperature relationship. The master curve construction was done using an Excel spreadsheet with the solver function, which is a tool for performing optimization with non-linear least squares regression technique. The analysis of over sixty mixtures indicated that the experimental a{\textasciitilde}proach agreed the best with the Arrhenius shifting equation, correlation coefficient R being 0.922. Also, the experimental shifting was most flexible, producing the best fit among the studied shifting equations due to the fact that it has the most degree of freedom.},
	language = {en},
	urldate = {2022-10-18},
	booktitle = {Recent {Advances} in {Materials} {Characterization} and {Modeling} of {Pavement} {Systems}},
	publisher = {American Society of Civil Engineers},
	author = {Pellinen, Terhi K. and Witczak, Matthew W. and Bonaquist, Ramon F.},
	month = dec,
	year = {2003},
	pages = {83--101},
	file = {Asphalt Mix Master Curve Construction Using Sigmoidal Fitting Function with Non- (2003).pdf:D\:\\Personal\\OneDrive\\Dokumentumok\\Literature\\Pavement\\Asphalt Mix Master Curve Construction Using Sigmoidal Fitting Function with Non- (2003).pdf:application/pdf},
}


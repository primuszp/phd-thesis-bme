@article{phan2022determining,
	title = {Determining with {High} {Accuracy} the {Relaxation} {Modulus} and {Creep} {Compliance} of {Asphaltic} {Materials} in the {Form} of {Sums} of {Exponential} {Functions} from {Mathematical} {Master} {Curves} of {Dynamic} {Modulus}},
	volume = {34},
	issn = {0899-1561, 1943-5533},
	url = {https://ascelibrary.org/doi/10.1061/%28ASCE%29MT.1943-5533.0004366},
	doi = {10.1061/(ASCE)MT.1943-5533.0004366},
	abstract = {According to the physical causality principle, the two components of complex modulus are not independent yet interrelated to each other via Kramers-Kronig relationships. Using two mathematical functions to predict simultaneously the dynamic modulus (DM) and phase angle (PA) generally leads to the violation of the causality principle. Therefore, the calculation of one component based on the other one is a vital task for using mathematical models to predict the linear viscoelastic (LVE) behavior of asphaltic materials. In addition, the relaxation modulus (RM) or the creep compliance (CC) in the form of sums of exponential functions (SEFs) is necessary for the efficient resolution of the stress{\textendash}strain relationship in the time domain. This paper presented a novel method for calculating with high accuracy the RM and CC in the form of SEFs based on the input DM master curve. First, the midpoint integration scheme was used to calculate the PA based on the exact relationship between the PA and DM. After that, the storage modulus and compliance were computed and decomposed with high accuracy into SEFs using a special technique. Then, the closed-form formula of the RM and CC were derived thanks to the special form function of the storage modulus and compliance. Finally, the special technique was used once again to decompose with high accuracy the RM and CC into SEFs for possible uses in finite-element method (FEM) analysis in the time domain. The results showed that the relative errors of all LVE properties computed were lower than 0.1 percent at all calculating points. DOI: 10.1061/(ASCE)MT.1943-5533.0004366. {\textcopyright} 2022 American Society of Civil Engineers.},
	language = {en},
	number = {9},
	urldate = {2023-06-20},
	journal = {Journal of Materials in Civil Engineering},
	author = {Phan, Thanh-Nhan and Nguyen, Duy-Liem and Vu, Tan-Van and Tran, Vu-Tu and Nguyen, H. T. Tai and Nguyen, Mai Lan},
	month = sep,
	year = {2022},
	pages = {04022219},
	file = {Determining with High Accuracy the Relaxation Modulus and Creep Compliance of As (2022).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Determining with High Accuracy the Relaxation Modulus and Creep Compliance of As (2022).pdf:application/pdf},
}

@article{ghorbanebrahimi2014interconversion,
	title = {Interconversion between viscoelastic functions using the {Tikhonov} regularisation method and its comparison with approximate techniques},
	volume = {15},
	issn = {1468-0629, 2164-7402},
	url = {http://www.tandfonline.com/doi/abs/10.1080/14680629.2014.924428},
	doi = {10.1080/14680629.2014.924428},
	abstract = {Asphalt concrete behaves as a viscoelastic material under normal traffic loading and field conditions. The stress strain behavior depends on the rate of loading and the actual pavement temperature. In order to model the viscoelastic behavior of the asphalt materials, viscoelastic functions need to be determined. In this study, uniaxial static creep test was carried out for AC 20 and AC 14 asphalt mixtures. Several asphalt specimens were tested at different temperatures subjected to various deviator stresses in order to verify the proposed approach. Prony series for creep compliance were determined for raw and smoothed data. Various optimization techniques were utilized to ensure monotonic increase of the Prony coefficient. A number of approximate interconversion techniques were evaluated in determining relaxation modulus resulted from the creep compliance interconversion. It was clear that, Prony series constants affect the interconverted relaxation modulus. It was also obvious that using the discretization of the slope of n value (slope of log creep compliance with log t) over the time domain instead of using one single constant value of the slope provides better solution of the interconverted relaxation modulus. Finally, the exact interconversion method was also applied to check the accuracy of approximate techniques. Tikhonov regularization with L ? Curve method was considered to solve the convolution integral. The exact solution was recommended as a result of investigating the extracted data. The approximate solution showed around 7.0\% error comparing different approaches.},
	language = {en},
	number = {4},
	urldate = {2022-09-29},
	journal = {Road Materials and Pavement Design},
	author = {Ghorban Ebrahimi, Milad and Saleh, Mofreh and Gonzalez, Miguel A Moyers},
	month = oct,
	year = {2014},
	pages = {820--840},
	file = {Interconversion between viscoelastic functions using the Tikhonov regularisation (2014).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Interconversion between viscoelastic functions using the Tikhonov regularisation (2014).pdf:application/pdf},
}

@article{mun2007determination,
	title = {Determination of {Time}-domain {Viscoelastic} {Functions} using {Optimized} {Interconversion} {Techniques}},
	volume = {8},
	issn = {1468-0629, 2164-7402},
	url = {https://www.tandfonline.com/doi/full/10.1080/14680629.2007.9690078},
	doi = {10/ghgb67},
	abstract = {Several viscoelastic response functions are available to characterize the LVE behavior of asphalt concrete, some in time domain such as relaxation modulus E(t) and creep compliance D(t) and other such as complex modulus E* in frequency domain. The use of the complex modulus test has risen sharply after it has been incorporated in the M-E Pavement Design Guide and in the Superpave Simple Performance Test. With the availability of E* data it becomes advantageous to use mathematical interconversion techniques to obtain timedomain functions E(t) and D(t) which are typically used for constitutive modeling and other applications. This paper addresses the steps involved in conducting the interconversion between frequency-domain and time-domain functions. Issues considered include: a) presmoothing of raw data, b) refinement of phase angle data, c) Prony series representation of the fitted data including determination and sign-control of the Prony series coefficients, and d) interconversion techniques: approximate vs. exact. Finally, interconversion methods are evaluated by comparing D(t) data converted from E* to that measured in the lab.},
	language = {en},
	number = {2},
	urldate = {2020-10-21},
	journal = {Road Materials and Pavement Design},
	author = {Mun, Sungho and Chehab, Ghassan R. and Kim, Y. Richard},
	month = jan,
	year = {2007},
	pages = {351--365},
	file = {Determination of Time-domain Viscoelastic Functions using Optimized Interconvers (2007).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Determination of Time-domain Viscoelastic Functions using Optimized Interconvers (2007).pdf:application/pdf},
}

@article{bazi2022asphalt,
	title = {Asphalt {Concrete} {Master} {Curve} {Using} {Dynamic} {Backcalculation}},
	volume = {23},
	issn = {1029-8436, 1477-268X},
	url = {https://www.tandfonline.com/doi/full/10.1080/10298436.2020.1733567},
	doi = {10/gnrknk},
	abstract = {The dynamic backcalculation of pavement layer properties, and more specifically the ability to determine the asphalt concrete master curve, using Falling Weight Deflectometer (FWD) data has caught the attention of many researchers for years. The damaged or aged master curve of existing pavement structures allows the accurate prediction of the pavement structural capacity and remaining life {\textendash} a goal that cannot be achieved through laboratory testing. To address this need, the authors developed a dynamic backcalculation application that employs the ABAQUS software for forward calculation using implicit dynamic analyses, and the Newton-Raphson{\textquoteright}s root-solving algorithm for optimisation. The capabilities of the application were demonstrated for three simulated flexible pavement structures and two asphalt concrete mixes using 40 combinations. The asphalt concrete moduli at the FWD most dominant frequencies around 17 Hz, and the variables of unbound layers converged to the exact values in few iterations for all combinations. The master curves, and mainly the maximum moduli, were reliably determined to less than 1\% and 4\% error for about 60\% and 85\% of the combinations, respectively. The potential for determining the master curve and maximum modulus was shown to be dependent on the asphalt concrete mix, asphalt concrete temperature and pavement structure.},
	language = {en},
	number = {1},
	urldate = {2021-12-12},
	journal = {International Journal of Pavement Engineering},
	author = {Bazi, Gabriel and Assi, Tatiana Bou},
	month = jan,
	year = {2022},
	pages = {95--106},
	file = {Asphalt Concrete Master Curve Using Dynamic Backcalculation (2022).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Asphalt Concrete Master Curve Using Dynamic Backcalculation (2022).pdf:application/pdf},
}


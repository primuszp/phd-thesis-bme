@article{cho2018finiteelement,
	title = {Finite {Element} {Method} analysis for mechanistic design in flexible pavement, {Review}: {From} how to build a material in {FE} analysis to complexity in reality},
	volume = {70},
	issn = {0013970X, 20644477},
	shorttitle = {Finite {Element} {Method} analysis for mechanistic design in flexible pavement, {Review}},
	url = {http://epitoanyag.org.hu/static/upload/10.14382_epitoanyag-jsbcm.2018.35.pdf},
	doi = {10/gfvbkb},
	abstract = {There are plenty of applications of finite element methods (FEM) in various fields. FEM itself stands strong in the field of structural analysis and the trend of applying it into asphalt pavement is widespread. As the mechanistic analysis becomes an important part of pavement design for the estimation of its structural response, FEM in terms of precise mechanical design became one of a strategic tool. Hereinafter a short overview of FEM adapted flexible pavement design field will be introduced. The main focus will be on how the material model for each layer of pavement structure is embodied in FE modeling. The aim of this overview is to show a stream of FEM application in flexible pavement design and call an attention to its potential. A strong point and shortcoming will be introduced as well, and try to reflect recent trends.},
	language = {english},
	number = {6},
	urldate = {2019-02-10},
	journal = {Epitoanyag - Journal of Silicate Based and Composite Materials},
	author = {Cho, Seoyoung and T{\'o}th, Csaba and So{\'o}s, Zolt{\'a}n},
	year = {2018},
	pages = {204--208},
	file = {Finite Element Method analysis for mechanistic design in flexible pavement, Revi (2018).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Finite Element Method analysis for mechanistic design in flexible pavement, Revi (2018).pdf:application/pdf},
}


}

@incollection{archilla2022comprehensive,
	address = {Cham},
	title = {Comprehensive {Model} for the {Prediction} of the {Phase} {Angle} {Master} {Curve} of {Asphalt} {Concrete} {Mixes}},
	volume = {27},
	isbn = {978-3-030-46454-7},
	url = {https://link.springer.com/10.1007/978-3-030-46455-4_60},
	abstract = {Viscoelastic analysis of asphalt concrete pavements requires information on dynamic modulus, {\textbar}E*{\textbar}, and phase angle, $\varphi$. While several efforts have been directed at developing predictive models for {\textbar}E*{\textbar}, predictive models for phase angle $\varphi$ have received much less attention. This paper presents a comprehensive predictive model for phase angle master curve based on the Lorentzian equation. The model was estimated using 6742 observations of 262 specimens from three different data sets, two from Hawaii and the other from Costa Rica, containing variables in common such as frequency, temperature, air voids, binder content, binder type, and gradation and variables about mix characteristics and testing conditions not available in some data sets, such as confinement level, number of freeze-thaw cycles (as a surrogate of moisture susceptibility), antistripping agents, and fibers. The predictive equation incorporates the effects of these variables on the three parameters of the Lorentzian function as well as on the parameters of the temperature shift factor function. The model parameters were estimated using joint estimation to identify the effects of variables with variations in only some datasets but simultaneously considering variables common to all data sets, and mixed effects to account for unobserved heterogeneity between specimens. All the previous factors were found to be statistically significant and to affect one or more of the parameters of the Lorentzian function. The paper shows that the model provides an excellent fit to the data and discusses briefly the effects of some variables.},
	language = {en},
	urldate = {2022-10-20},
	booktitle = {Proceedings of the {RILEM} {International} {Symposium} on {Bituminous} {Materials}},
	publisher = {Springer International Publishing},
	author = {Archilla, Adri{\'a}n Ricardo and Corrales-Azofeifa, Jos{\'e} Pablo and Aguiar-Moya, Jos{\'e} P.},
	editor = {Di Benedetto, Herv{\'e} and Baaj, Hassan and Chailleux, Emmanuel and Tebaldi, Gabriele and Sauz{\'e}at, C{\'e}dric and Mangiafico, Salvatore},
	year = {2022},
	doi = {10.1007/978-3-030-46455-4_60},
	note = {Series Title: RILEM Bookseries},
	pages = {473--479},
	file = {Comprehensive Model for the Prediction of the Phase Angle Master Curve of Asphalt Concrete (2022).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Comprehensive Model for the Prediction of the Phase Angle Master Curve of Asphalt Concrete (2022).pdf:application/pdf},
}

@article{ma2022dynamic,
	title = {Dynamic {Characteristic} {Master} {Curve} and {Parameters} of {Different} {Asphalt} {Mixtures}},
	volume = {12},
	issn = {2076-3417},
	url = {https://www.mdpi.com/2076-3417/12/7/3619},
	doi = {10.3390/app12073619},
	abstract = {Using an AMPT tester and based on laboratory tests, this paper performed a comparative study on the dynamic characteristics of different asphalt mixtures, analyzed the influence of different asphalt binders on the characteristic parameters of the dynamic modulus master curve and the phase angle master curve of asphalt mixture, and expounds the evaluation function of the phase angle master curve for mixture relaxation characteristics. The results show that the modulus master curve parameters of the asphalt mixture are closely related to voids in the mineral aggregate, mixture density, and asphalt content of the asphalt mixture. For the same kind of asphalt mixture, because the gradation of mineral aggregate is fixed and the volume parameters are almost the same, the ultimate modulus of the mixture at different temperatures is unique; when the temperature changes or the asphalt changes, the shape parameter $\beta$ of the modulus master curve changes regularly, which brings different dynamic responses, and the lower $\beta$ will show the characteristics of a higher modulus. Asphalt is the source of the viscoelasticity of the asphalt mixture. Although the influence of particle gradation of the mixture will bring about the change of modulus, the phase angle of the mixture depends on the viscoelastic properties of asphalt, and the initial phase angle in the main curve is positively correlated with asphalt penetration and negatively correlated with the softening point and viscosity, while the peak phase angle A is negatively correlated with penetration, and the softening point viscosity is positively correlated. The viscoelastic interval, represented by $\omega$, is negatively correlated with penetration but positively correlated with the softening point and viscosity. The peak position, parameter $\omega$c, of the phase angle master curve can evaluate the relaxation characteristics of the mixture, and the crack resistance of different mixtures can be compared without complex model calculation. In the comparison of the relaxation time of asphalt mixture, the relaxation time of foam cold-recycled mixture is the largest, which is significantly higher than that of other forms of cement mixture; the emulsified asphalt cold-recycled mixture is equivalent to AC20 and LSPM30 mixtures; the SBS-modified asphalt mixture has the best relaxation characteristics.},
	language = {en},
	number = {7},
	urldate = {2022-10-20},
	journal = {Applied Sciences},
	author = {Ma, Shijie and Fan, Liang and Ma, Tao and Dong, Zhao and Zhang, Yuzhen and Zhang, Xiaomeng},
	month = apr,
	year = {2022},
	pages = {3619},
	file = {Dynamic Characteristic Master Curve and Parameters of Different Asphalt Mixtures (2022).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Dynamic Characteristic Master Curve and Parameters of Different Asphalt Mixtures (2022).pdf:application/pdf},
}

@inproceedings{archilla2019aflexible,
	address = {Chicago, Illinois},
	title = {A {Flexible} {Functional} {Form} for {Modeling} {Phase} {Angle} of {Asphalt} {Concrete} {Mixes}},
	isbn = {978-0-7844-8246-9},
	url = {https://ascelibrary.org/doi/10.1061/9780784482469.021},
	doi = {10.1061/9780784482469.021},
	abstract = {Viscoelastic analysis of asphalt concrete pavements requires information to be collected on dynamic modulus, {\textbar}E*{\textbar}, and phase angle, ? . Since these are collected at only a few temperatures and frequencies, the data are typically used to construct master curves for each property, which allows the interpolation of {\textbar}E*{\textbar} and ? for any temperature and frequency of interest. Several efforts have been directed at developing predictive models that allow their computation based on mix characteristics. However, to date, predictive models for {\textbar}E*{\textbar} have received much more attention because of their use in linear elastic based mechanistic-empirical design procedures and the greater difficulty in modeling the shape of the ? master curve. Phase angle has typically been modeled as a function of {\textbar}E*{\textbar}, using a generalized form of the beta distribution, or using the 3 parameters Lorentzian equation. However, no predictive model has yet been developed with these equations. This paper presents the rationale of a 5-parameter flexible functional form for modeling the phase angle, how changes in each parameter affects its shape, and some preliminary results from two comprehensive predictive models developed using the Lorentzian and the proposed 5-parameter equations.},
	language = {en},
	urldate = {2022-10-20},
	booktitle = {Airfield and {Highway} {Pavements} 2019},
	publisher = {American Society of Civil Engineers},
	author = {Archilla, A. R.},
	month = jul,
	year = {2019},
	pages = {204--215},
	file = {A Flexible Functional Form for Modeling Phase Angle of Asphalt Concrete Mixes (2019).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/A Flexible Functional Form for Modeling Phase Angle of Asphalt Concrete Mixes (2019).pdf:application/pdf},
}

@article{nemati2018nominal,
	title = {Nominal {Property} {Based} {Predictive} {Models} for {Asphalt} {Mixture} {Complex} {Modulus} (dynamic {Modulus} and {Phase} {Angle})},
	volume = {158},
	issn = {09500618},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0950061817319682},
	doi = {10.1016/j.conbuildmat.2017.09.144},
	abstract = {Dynamic modulus ({\textbar}E{\textfractionsolidus}{\textbar}) and phase angle (d) are necessary for determining the response of asphalt mixtures to in-service traffic and thermal loadings. While a number of {\textbar}E{\textfractionsolidus}{\textbar} and d predictive models have been developed, many of them require lab measured properties (e.g. binder complex modulus). The majority of previous work has focused only on prediction of {\textbar}E{\textfractionsolidus}{\textbar}, limited models exist for prediction of d. This research utilized generalized regression modelling of lab measurements (from 81 asphalt mixtures) to develop and verify prediction models for {\textbar}E{\textfractionsolidus}{\textbar} and d using only nominal asphalt mix properties that are readily available during the initial mixture design and specification process.},
	language = {en},

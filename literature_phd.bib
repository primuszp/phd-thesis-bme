@article{cheng2022effects,
	title = {Effects of {Using} {Different} {Dynamic} {Moduli} on {Predicted} {Asphalt} {Pavement} {Responses} in {Mechanistic} {Pavement} {Design}},
	volume = {23},
	issn = {1468-0629, 2164-7402},
	url = {https://www.tandfonline.com/doi/full/10.1080/14680629.2021.1924842},
	doi = {10.1080/14680629.2021.1924842},
	abstract = {In this study, dynamic moduli of asphalt mixtures under uniaxial compression (UC), indirect tension (IDT) and four-point bending (4PB) loading modes were tested and incorporated in the MEPDG procedure to predict the pavement responses. The field responses from a full-scale asphalt pavement were used to evaluate the prediction accuracies of three types of moduli. It was found that the current MEPDG procedure using UC modulus underestimates the strain responses of the pavement. Alternatively, the use of 4PB modulus in the MEPDG generates accurate strain predictions at the intermediate temperatures, but not at high temperatures. The combined use of UC modulus and the adjusted loading frequency, f = 1/(2$\pi$t) also generates accurate strain predictions at the intermediate temperatures. At high temperatures, the combined use of the 4PB modulus and f = 1/(2$\pi$t) was found to generate the most accurate prediction results. Accurate prediction of asphalt pavement responses is apparently dependent on the proper selection of modulus type and loading frequency.},
	language = {en},
	number = {8},
	urldate = {2022-09-05},
	journal = {Road Materials and Pavement Design},
	author = {Cheng, Huailei and Wang, Yuhong and Liu, Liping and Sun, Lijun},
	month = aug,
	year = {2022},
	pages = {1860--1876},
	file = {Effects of Using Different Dynamic Moduli on Predicted Asphalt Pavement Responses in Mecha (2022).pdf:E\:\\OneDrive\\Dokumentumok\\Literature\\Pavement\\Effects of Using Different Dynamic Moduli on Predicted Asphalt Pavement Responses in Mecha (2022).pdf:application/pdf},
}


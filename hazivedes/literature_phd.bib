@article{abdollahi2020development,
	title = {Development of a {Computer} {Program} for {Calculation} of the {Alpha} {Parameter} in the {Linear} {Amplitude} {Sweep} {Test} and {Comparison} with {Rheological} {Parameters}},
	volume = {2674},
	issn = {0361-1981, 2169-4052},
	url = {http://journals.sagepub.com/doi/10.1177/0361198120922042},
	doi = {10.1177/0361198120922042},
	abstract = {Characterizing and modeling the fatigue performance of an asphalt binder is important when designing asphalt mixtures which can resist premature fatigue failure. Performance grading (PG) standards include the fatigue factor (G*.sind) to evaluate the fatigue resistance of asphalt binders. This criterion seems to be inaccurate, especially when applied to modified asphalt binders. American Association of State Highway and Transportation Officials (AASHTO) TP 101 has been designed to evaluate the fatigue resistance of asphalt binders using Schapery{\textquoteright}s work potential theory. The damage evolution rate (a parameter) is the key element of this method and is calculated from the rheological properties of the undamaged asphalt binder using the slope of the relaxation modulus versus the time on the log-log scale. Owing to the difficulties of conducting the relaxation test, the relaxation modulus is usually obtained using conversion methods. However, AASHTO TP 101 uses a simplified indirect method to calculate a. The present study developed a computer program called RheoSUT with which to construct relaxation master curves using different methods. The relaxation master curves of 27 asphalt binders were evaluated for estimation of the value of a. The results indicated that AASHTO TP 101 yields higher values of a. The results of the sensitivity analysis show that overestimation of a will result in up to about 200\% error in the estimation of the fatigue life (Nf). It is also shown that binder aging and styrene-butadiene-styrene (SBS) modification directly affected the rheological parameters and relaxation master curves. Finally, it is recommended to use the relaxation-master curved based methods of calculation of a instead of the storage-modulus based ones.},
	language = {en},
	number = {7},
	urldate = {2023-01-05},
	journal = {Transportation Research Record: Journal of the Transportation Research Board},
	author = {Abdollahi, Seyed Farhad and Farrokhi, Mehdi and Tabatabaee, Nader},
	month = jul,
	year = {2020},
	pages = {284--298},
	file = {Development of a Computer Program for Calculation of the Alpha Parameter in the Linear Amp (2020).pdf:/Users/primuszp/Library/CloudStorage/OneDrive-Szeme?lyes/Dokumentumok/Literature/Pavement/Development of a Computer Program for Calculation of the Alpha Parameter in the Linear Amp (2020).pdf:application/pdf},
}


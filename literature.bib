@unpublished{buchanan2007resilient,
	address = {Birmingham, Alabama, Egyes{\"u}lt {\'A}llamok},
	type = {Jegyzet},
	title = {Resilient {Modulus}: {What}, {Why}, and {How}},
	abstract = {Resilient modulus (Mr ) continues to be a key design parameter for pavement systems. Accurate knowledge of the resilient modulus of pavement layer materials allows determination of how the  pavement system will respond to traffic loadings. While resilient modulus has been used by many for years, much of its use has been without accurately understanding many key items. Among these items are 1) what is resilient modulus?, 2) how is it determined?, 3) what are typical values?, 4) what influences resilient modulus?, and 5) how is it used in the design of  pavement systems? This document will attempt to provide answers to these key questions.},

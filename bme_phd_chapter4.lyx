\begin_inset Formula 
\begin{align}
E^{\prime\prime}\left(\omega\right) & =\frac{2\omega}{\pi}\int_{0}^{+\infty}\frac{E^{\prime}\left(u\right)-E^{\prime}\left(\omega\right)}{u^{2}-\omega^{2}}\text{d}u\label{eq:kk-loss-modulus}\\
\phi\left(\omega\right) & =\frac{2\omega}{\pi}\int_{0}^{+\infty}\frac{\ln\left|E^{*}\left(u\right)\right|-\ln\left|E^{*}\left(\omega\right)\right|}{u^{2}-\omega^{2}}\text{d}u\label{eq:kk-phase-angle}
\end{align}


key "christensen1982theoryof"
literal "false"

\end_inset

; 
\begin_inset CommandInset citation
LatexCommand cite
key "daniel1998relationships"
literal "false"

\end_inset

; 
\begin_inset CommandInset citation
LatexCommand cite
key "dongre2006conversion"
literal "false"

\end_inset

; 
\begin_inset CommandInset citation
LatexCommand cite
key "katicha2008conversion"
literal "false"

\end_inset

; 
\begin_inset CommandInset citation
LatexCommand cite
key "al-qadi2008frequency"
literal "false"

\end_inset

; 
\begin_inset CommandInset citation

\begin_layout Standard
Minden regressziós modellre kiszámítottam 
\begin_inset Formula $Y$
\end_inset

 változó becslésnek 
\begin_inset Formula $X$
\end_inset

-re vonatkozó standard hibáját (
\begin_inset Formula $S_{e}$
\end_inset

), tapasztalati szórását (
\begin_inset Formula $S_{y}$
\end_inset

) és az ún.
 korrigált determinációs együtthatóját (
\begin_inset Formula $R_{*}^{2}$
\end_inset

).
 A becslés standard hibájának (standard error of estimation) az összefüggése
 a következő:
\begin_inset Formula 
\begin{equation}
S_{e}=\sqrt{\frac{{\displaystyle \sum}_{i=1}^{N}\left(Y_{i}-\hat{Y}_{i}\right)^{2}}{N-M-1}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
ahol 
\begin_inset Formula $N$
\end_inset

 a minta mérete, 
\begin_inset Formula $M$
\end_inset

 a független változók, az illesztett paraméterek száma, 
\begin_inset Formula $Y_{i}$
\end_inset

 a mért érték és 
\begin_inset Formula $\hat{Y_{i}}$
\end_inset

 az előre jelzett érték.
\end_layout

\begin_layout Standard
A minta tapasztalati szórása (standard deviation):
\begin_inset Formula 
\begin{equation}
S_{y}=\sqrt{\frac{{\displaystyle \sum}_{i=1}^{N}\left(Y_{i}-\bar{Y}\right)^{2}}{N-1}}
\end{equation}

